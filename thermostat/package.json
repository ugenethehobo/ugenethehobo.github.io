{
  "name": "home-climate",
  "version": "1.0.0",
  "private": true,
  "description": "A fast, private replacement for the Alexa app's thermostat controls, with remote sensors, schedules with manual holds, and smart heat/cool changeover.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "demo": "DRIVER=mock node server/index.js",
    "dev": "wrangler dev --var DRIVER:mock",
    "deploy": "wrangler deploy",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {},
  "devDependencies": {
    "wrangler": "4.136.3"
  }
}
