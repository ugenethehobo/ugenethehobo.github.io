{
  // Cloudflare Workers config. Deployed by Cloudflare's GitHub integration
  // (Workers Builds) with `npx wrangler deploy`. The dashboard Worker name
  // must match "name" below.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "home-climate",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "HOUSE", "class_name": "House" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["House"] }],
  "vars": {
    "AMAZON_PAGE": "amazon.com"
  },
  "observability": { "enabled": true }
}
